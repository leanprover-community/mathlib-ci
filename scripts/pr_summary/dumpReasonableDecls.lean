import Lean
import ImportGraph.Imports.ImportGraph
import ImportGraph.Graph.TransitiveClosure
-- The API dump reads these extensions' entries. They must be the dumper's own imports: the
-- import does not run imported modules' `initialize` blocks, which register them.
import Mathlib.Tactic.ToDual
import Mathlib.Tactic.ToAdditive
import Batteries.Tactic.Alias

/-!
# Dump "reasonable" declarations, transitive-import counts and the API

## Outputs

* `--out FILE`: writes one "reasonable" declaration name per line,
  sorted by name. "Reasonable" = not `private`, not `unsafe`, and not
  flagged by `Lean.Name.isInternalDetail`. Autogenerated outputs from
  `to_additive` / `to_dual` / `to_op` are included.

* `--imports-out FILE`: writes a single-line JSON object mapping each
  root-prefixed module to the size of its transitive closure in
  `Lean.Environment.importGraph`.

* `--api-out FILE`: writes the API dump, one JSON object per line: a
  header, then a row for each reasonable declaration, then a row for
  each module. See *The API dump*.

* `--out-dir DIR`: writes the CI outputs to `DIR/imports.json` and
  `DIR/api.jsonl`, except for any that `--imports-out` or `--api-out`
  gives a path of its own. `declsDiff.py` reads a
  directory laid out this way (`--ref-dir`, `--new-dir`), so CI can
  upload and check it as a whole. The API dump lists the names
  `--out` would, so `--out` is for local use; `declsDiff.py` still
  reads `decls.txt` from directories written before the API dump
  was added.

The flags can be combined; every file is produced from one env load.
If no output flag is given, defaults to `--out reasonable_decls.txt`.

## The API dump

The first line is a header such as `{"fields":{"k":1,"m":1,"mod":1,"n":1},"schema":1}`.

* `schema` is the version of the format as a whole: the header, the
  two kinds of row, and the keys `n` and `mod` that identify them.
* `fields` contains the versions of the fields corresponding to its keys.
  A field's version is bumped whenever its values stop being
  comparable with the old ones, for example after changing a hash
  function.

(The current versions are recorded in `apiSchema` and `apiFields` below.)

The base side of a PR's comparison comes from a `master` artifact up to
90 days old, so:

* A reader compares a field only when both sides are at the same version.
* The keys `n` and `mod` are the exception: `declsDiff.py` compares
  names whatever the other fields are at, so they stay at version 1,
  and changing what they hold needs a new `schema`.
* The reader (`apiDump.py`) goes on reading every `schema` up to its
  own. If it stopped reading an older one, every comparison against a
  `master` artifact written before the bump would fail.

Declaration rows and module rows share the one `fields` map, so a key
belongs to one kind of row only: a module-row field can never be
called `m`, for example.

A row leaves out a field whose value is the empty one in the tables
below, and a reader then takes that value; a field with `—` is in
every row of its kind. Hashes are written as decimal strings.

Declaration rows, sorted by name:

| key | version | empty | meaning |
|-----|---------|-------|---------|
| `n` | 1 | — | declaration name, exactly as written by `--out` |
| `k` | 1 | — | kind: `thm` / `def` / `ax` / `ind` / `ctor` / `rec` / `opaq` / `quot` |
| `m` | 1 | — | defining module |
| `t` | 1 | — | hash of the type, normalised (*Hashing*) |
| `te` | 1 | — | `t` with every universe level erased, 32 bits: the same `te` and another `t` mean only the universes changed |
| `v` | 1 | `null` | hash of the value, normalised as `t` is; none for theorems |
| `d` | 1 | `null` | hash of the docstring, trimmed; none for the docstring `alias` generates (`isAliasDocstring`) |
| `a` | 1 | `[]` | the attributes probed, sorted (*Attributes*) |
| `p` | 1 | `false` | `protected` |
| `x` | 1 | `null` | the declaration this one is a `to_additive` or `to_dual` translation of |
| `g` | 1 | `false` | looks generated by an attribute: its declaration range is its attribute's |
| `dep` | 1 | `null` | `{to, since, text}` from `@[deprecated]` |
| `al` | 1 | `null` | `{k, of}` from Batteries' `alias`: `k` is `plain`, `forward` or `reverse` |
| `rs` | 1 | `false` | a reserved name realised on demand (`foo.eq_1`, `foo.congr_simp`) |
| `nu` | 1 | `0` | the number of universe parameters |
| `uo` | 1 | `null` | `{d, p}` when the universe parameters are not declared in canonical order (*Hashing*): the declared names, and the canonical position of each |
| `l` | 1 | `null` | the line of the declaration's name in its source; for a declaration made by an attribute, the attribute's. Where it is, not what it is: never compared |

Module rows, sorted by name:

| key | version | empty | meaning |
|-----|---------|-------|---------|
| `mod` | 1 | — | module name |
| `dm` | 1 | `null` | `{since, text}` from `deprecated_module` |
| `md` | 1 | `null` | hash of the module docstrings, each trimmed |
| `imp` | 1 | `[]` | the module's imports, for a deprecated module only, where they name its replacement |
| `src` | 1 | `null` | hash of the module's source file, found through `LEAN_SRC_PATH`. It differs between two sides exactly when the file is in the diff. Never compared |

### Hashing

`t` and `v` come from a structural hasher that erases what does not
change a declaration's meaning to its callers: binder names, `mdata`,
universe parameter names, how a level is written, the order of the
arguments in a nest of `max`es, and proofs. It is not rename-invariant:
each declaration is compared with itself, so the constants it mentions
count by name.

* Universe parameters are numbered in **canonical order**: by first
  appearance in the type, then, for those it does not mention, as
  declared. `Type*` does not keep the declared order, which is what
  `foo.{a, b}` binds, so that is recorded on its own, as `uo`. The
  universe arguments of a constant a term mentions are hashed in that
  constant's canonical order.
* A **proof** is an application headed by a theorem, or a `fun` whose
  body is one, and hashes as one constant. Lean lifts a proof inside a
  definition or a statement into a theorem `foo._proof_n`, numbered by
  position, so dropping one renumbers the rest. Terms that differ only
  in proofs are definitionally equal.

### Attributes

Lean has no generic way to ask which attributes a declaration has, so
each is read from its own extension's per-module entries, which the
import stores whether or not it runs the extensions' import hooks:

* `simp` (forward lemmas) and `simp-unfold`; `norm_cast` and `push_cast`;
* `instance:PRIO`, for global instances;
* `reducibility:[LEVEL]`, for any level but `semireducible`;
* `ext`;
* `defeq`, which `dsimp` reads.

`scoped` attributes are not recorded.

### Extensions read as empty

A toolchain bump can change an extension so that reading its entries
silently returns nothing, rather than failing to compile. So the dumper
counts what it reads, and an extension that reads as empty leaves the
fields it feeds out of the header and out of every row, with a warning:
`a` for the simp sets, instances and `ext`; `x` for the translation
maps; `rs` for matchers; `g` and `l` when no declaration has a range.
A reader then does not compare them, rather than reporting every one
changed, and the dump still succeeds.

## Roots

Positional `ROOT` arguments are Lean module names (e.g. `Mathlib`,
`Plausible`). Each is imported and used as a `Name`-prefix filter on
every output. At least one `ROOT` is required for the dumps to be
non-empty.

## Usage

```
lake env lean --run scripts/pr_summary/dumpReasonableDecls.lean \
    [-o DECLS_OUT | --out DECLS_OUT] \
    [--imports-out IMPORTS_OUT] \
    [--api-out API_OUT] \
    [--out-dir DIR] \
    [ROOT ...]
```

## Dependencies

`Lean`, the `importGraph` package, and from Mathlib and Batteries the
modules that register the extensions the API dump reads. Runs in a
mathlib checkout, through `lake env`.
-/

open Lean

/-- Command-line configuration. -/
structure Config where
  /-- Path for the declarations dump; `none` means "don't dump declarations". -/
  declsOut   : Option System.FilePath := none
  /-- Path for the transitive-import counts JSON; `none` means "don't dump imports". -/
  importsOut : Option System.FilePath := none
  /-- Path for the API dump; `none` means "don't dump the API". -/
  apiOut     : Option System.FilePath := none
  /-- Directory for the CI outputs not given paths of their own; see `Config.withOutDir`. -/
  outDir     : Option System.FilePath := none
  /-- Module roots to import (via `withImportModules`) and use as a
  `Name`-prefix filter on every output. Empty disables the filter. -/
  roots      : Array Name := #[]
  deriving Inhabited

def helpText : String :=
"Dump declarations, transitive imports and the API from a Lean environment.

Usage:
  lake env lean --run dumpReasonableDecls.lean [OPTIONS] [ROOT ...]

Outputs (any combination; all run in one env load):
  -o, --out FILE        write 'reasonable' declaration names (one per line)
      --imports-out F   write transitive-import counts as JSON
                        (object keyed by module name)
      --api-out F       write the API dump (JSON Lines: a header, then one
                        row per declaration and one per module)
      --out-dir DIR     write imports.json and api.jsonl into DIR, except
                        for any given a path by --imports-out or --api-out

If no output flag is given, defaults to `-o reasonable_decls.txt`.

Each ROOT (e.g. Mathlib) is imported, and every output is filtered to
modules under the root prefix. At least one ROOT is required for the
dumps to be non-empty.

Options:
  -o, --out FILE        decls output file
      --imports-out F   transitive-imports JSON file
      --api-out F       API dump file
      --out-dir DIR     directory for imports.json and api.jsonl
  -h, --help            show this message and exit
"

/-- Parse a `--out=`-style argument. Returns the embedded path if matched. -/
def parseOutEq? (arg : String) : Option String :=
  if arg.startsWith "--out=" then some (arg.drop "--out=".length).toString
  else if arg.startsWith "-o=" then some (arg.drop "-o=".length).toString
  else none

partial def parseArgs : List String → Config → IO Config
  | [],                                  cfg => pure cfg
  | "-h"     :: _,                       _
  | "--help" :: _,                       _   => do IO.println helpText; IO.Process.exit 0
  | ("-o" :: f :: rest),                 cfg => parseArgs rest { cfg with declsOut := some f }
  | ("--out" :: f :: rest),              cfg => parseArgs rest { cfg with declsOut := some f }
  | ("--imports-out" :: f :: rest),      cfg => parseArgs rest { cfg with importsOut := some f }
  | ("--api-out" :: f :: rest),          cfg => parseArgs rest { cfg with apiOut := some f }
  | ("--out-dir" :: d :: rest),          cfg => parseArgs rest { cfg with outDir := some d }
  | ("--imports-out" :: _),              _   =>
      throw <| IO.userError "--imports-out requires a file argument"
  | ("--api-out" :: _),                  _   =>
      throw <| IO.userError "--api-out requires a file argument"
  | ("--out-dir" :: _),                  _   =>
      throw <| IO.userError "--out-dir requires a directory argument"
  | (a :: rest),                         cfg =>
    if let some f := parseOutEq? a then
      parseArgs rest { cfg with declsOut := some f }
    else if a.startsWith "--imports-out=" then
      parseArgs rest { cfg with importsOut := some (a.drop "--imports-out=".length).toString }
    else if a.startsWith "--api-out=" then
      parseArgs rest { cfg with apiOut := some (a.drop "--api-out=".length).toString }
    else if a.startsWith "--out-dir=" then
      parseArgs rest { cfg with outDir := some (a.drop "--out-dir=".length).toString }
    else if a.startsWith "-" then
      throw <| IO.userError s!"unknown option: {a}\n\n{helpText}"
    else
      parseArgs rest { cfg with roots := cfg.roots.push a.toName }

/-- Set the paths of CI outputs that haven't been assigned paths yet, using `--out-dir` and the names
that `declsDiff.py` looks for. -/
def Config.withOutDir (cfg : Config) : Config :=
  match cfg.outDir with
  | none => cfg
  | some d => { cfg with
      importsOut := cfg.importsOut <|> some (d / "imports.json")
      apiOut     := cfg.apiOut     <|> some (d / "api.jsonl") }

/-- A constant is "reasonable" iff it is not `private`, not `unsafe`, and not
flagged as an internal detail (`Lean.Name.isInternalDetail`). -/
def isReasonable (n : Name) (ci : ConstantInfo) : Bool :=
  !n.isInternalDetail && !isPrivateName n && !ci.isUnsafe

/-- The `Name` of the module in which `n` is defined, or `none` if `n` has no
source module (e.g. it was synthesised in the current "input" module). -/
def sourceModule? (env : Environment) (n : Name) : Option Name := do
  let idx ← env.getModuleIdxFor? n
  env.allImportedModuleNames[idx.toNat]?

/-- True iff `m` is `prefix.<...>` (or `prefix` itself) for some `prefix` in `roots`.
An empty `roots` accepts everything. -/
def underAnyRoot (roots : Array Name) (m : Name) : Bool :=
  roots.isEmpty || roots.any (·.isPrefixOf m)

/-- True iff `n`'s source module is `prefix.<...>` for some `prefix` in `roots`.
An empty `roots` accepts everything. -/
def inAnyRoot (env : Environment) (roots : Array Name) (n : Name) : Bool :=
  if roots.isEmpty then true
  else match sourceModule? env n with
    | none   => false
    | some m => underAnyRoot roots m

/-- A reasonable declaration under the roots. This includes a rendering of the name as a string
for efficiency. -/
structure ReasonableDecl where
  str  : String
  name : Name
  info : ConstantInfo

/-- Iterate the constants once and collect the reasonable declarations under the roots,
sorted by name. `--out` and `--api-out` are both written from this, so they list the same names
in the same order. -/
def reasonableDecls (env : Environment) (roots : Array Name) : Array ReasonableDecl :=
  let decls := env.constants.fold (init := (#[] : Array ReasonableDecl)) fun acc n ci =>
    if isReasonable n ci && inAnyRoot env roots n then
      acc.push { str := n.toString, name := n, info := ci }
    else acc
  decls.qsort (·.str < ·.str)

/-- Write the reasonable-declaration dump. -/
private def writeDeclsDump (decls : Array ReasonableDecl) (outFile : System.FilePath) :
    IO Unit :=
  IO.FS.withFile outFile .write fun h => do
    for d in decls do h.putStrLn d.str

/-- The API dump's line format; see *The API dump*. -/
def apiSchema : Nat := 1

/-- Every key the API dump's rows use, with its version; see *The API dump*. -/
def apiFields : List (String × Nat) := [
  ("n", 1), ("k", 1), ("m", 1), ("t", 1), ("te", 1), ("v", 1), ("d", 1), ("a", 1), ("p", 1),
  ("x", 1), ("g", 1), ("dep", 1), ("al", 1), ("rs", 1), ("nu", 1), ("uo", 1), ("l", 1),
  ("mod", 1), ("dm", 1), ("md", 1), ("imp", 1), ("src", 1)]

/-- The names used in the `k` field. -/
def declKind : ConstantInfo → String
  | .axiomInfo _ => "ax" | .defnInfo _ => "def" | .thmInfo _ => "thm"
  | .opaqueInfo _ => "opaq" | .quotInfo _ => "quot"
  | .inductInfo _ => "ind" | .ctorInfo _ => "ctor" | .recInfo _ => "rec"

/-! ## Hashing (`t`, `te`, `v`) -/

private def hashBI : BinderInfo → UInt64
  | .default => 101 | .implicit => 103 | .strictImplicit => 107 | .instImplicit => 109

/-- The arguments of a nest of `max`es. -/
private def maxArgs : Level → Array Level
  | .max a b => maxArgs a ++ maxArgs b
  | l => #[l]

/-- A level, with each parameter by its position in `lp`. -/
private partial def hashLvl (lp : List Name) : Level → UInt64
  | .zero => 13
  | .succ l => mixHash 17 (hashLvl lp l)
  -- `max` is associative and commutative, and Lean orders its arguments by universe name when
  -- it normalises a level, so renaming `Type u` to `Type*` can swap them.
  | l@(.max _ _) => ((maxArgs l).map (hashLvl lp)).qsort (· < ·) |>.foldl mixHash 19
  | .imax a b => mixHash 23 (mixHash (hashLvl lp a) (hashLvl lp b))
  | .param n => mixHash 29 (hash ((lp.findIdx? (· == n)).getD 9999))
  | .mvar _ => 31

/-- The universe parameters of `e`, in the order `collectLevelParams` finds them, stopping once
it has found `n` of them: the same walk, with a visited set by address in place of
`collectLevelParams`' structural one, which made this 110 s on `Mathlib`. -/
private unsafe def firstLevelParamsImpl (n : Nat) (e : Expr) : Array Name :=
  ((go e).run (#[], {})).run.2.1
where
  done : StateM (Array Name × Std.HashSet USize) Bool := return (← get).1.size ≥ n
  lvl (u : Level) : StateM (Array Name × Std.HashSet USize) Unit := do
    if !u.hasParam || (← done) then return
    match u with
    | .succ v => lvl v
    | .max a b | .imax a b => do lvl a; lvl b
    | .param p => modify fun (ps, vs) => (if ps.contains p then ps else ps.push p, vs)
    | _ => pure ()
  go (e : Expr) : StateM (Array Name × Std.HashSet USize) Unit := do
    if !e.hasLevelParam || (← done) then return
    let k := ptrAddrUnsafe e
    if (← get).2.contains k then return
    modify fun (ps, vs) => (ps, vs.insert k)
    match e with
    | .proj _ _ s => go s
    | .forallE _ d b _ | .lam _ d b _ => do go d; go b
    | .letE _ t v b _ => do go t; go v; go b
    | .app f a => do go f; go a
    | .mdata _ b => go b
    | .const _ us => for u in us do lvl u
    | .sort u => lvl u
    | _ => pure ()

@[implemented_by firstLevelParamsImpl]
private def firstLevelParams (_ : Nat) (e : Expr) : Array Name :=
  (collectLevelParams {} e).params

/-- A constant's universe parameters in canonical order: first appearance in its type, then
the rest as declared. -/
def canonicalLevelParams (ci : ConstantInfo) : List Name :=
  if ci.levelParams.length < 2 then ci.levelParams else
  let seen := (firstLevelParams ci.levelParams.length ci.type).toList
  seen ++ ci.levelParams.filter (!seen.contains ·)

/-- For each constant whose declared and canonical orders differ, the declared position of each
of its universe parameters, in canonical order. Built once: per reference it would walk the
constant's type each time. -/
def canonicalArgOrders (env : Environment) : NameMap (Array Nat) :=
  env.constants.fold (init := {}) fun m n ci =>
    if ci.levelParams.length < 2 then m else
    let canon := canonicalLevelParams ci
    if canon == ci.levelParams then m else m.insert n (canon.toArray.map ci.levelParams.idxOf)

/-- `us`, the universe arguments of `n` in its declared order, in its canonical order. -/
private def canonicalArgs (orders : NameMap (Array Nat)) (n : Name) (us : List Level) :
    List Level :=
  if us.length < 2 then us else
  match orders.find? n with
  | some o => if o.size == us.length then o.toList.map (us[·]!) else us
  | none => us

/-- Is `n` a theorem? Then any application of it is a proof. -/
private def isTheorem (env : Environment) (n : Name) : Bool :=
  (env.find? n).any (·.isTheorem)

/-- Is `e` a proof the hasher erases: a theorem, applied or not, or a `fun` whose body is one? -/
private def isErasedProof (env : Environment) : Expr → Bool
  | .lam _ _ b _ => isErasedProof env b
  | e => match e.getAppFn with
    | .const c _ => isTheorem env c
    | _ => false

/-- The hash an erased proof is given, whatever the proof. -/
private def proofHash : UInt64 := 61

/-- The structural hash (*Hashing*). With `erase`, universe levels are left out altogether:
sorts hash alike, and so do a constant's instances at any universes. A term with no proof in
it hashes as it would if proofs were not erased. -/
private partial def hashE (env : Environment) (orders : NameMap (Array Nat)) (lp : List Name)
    (erase : Bool) : Expr → UInt64
  | .bvar i => mixHash 2 (hash i)
  | .fvar _ => 3
  | .mvar _ => 5
  | .sort l => if erase then 7 else mixHash 7 (hashLvl lp l.normalize)
  | .const n us => if isTheorem env n then proofHash else
      mixHash 11 (mixHash (hash n) <| if erase then 0 else
        (canonicalArgs orders n us).foldl (init := 0) fun h u => mixHash h (hashLvl lp u.normalize))
  | e@(.app ..) => if isErasedProof env e then proofHash else spine e
  | e@(.lam ..) => if isErasedProof env e then proofHash else lams e
  | .forallE _ d b bi => mixHash 43 (mixHash (go d) (mixHash (go b) (hashBI bi)))
  | .letE _ t v b _ => mixHash 47 (mixHash (go t) (mixHash (go v) (go b)))
  | .lit l => mixHash 53 (hash l)
  | .mdata _ e => go e
  | .proj s i e => mixHash 59 (mixHash (hash s) (mixHash (hash i) (go e)))
where
  go := hashE env orders lp erase
  /-- An application whose head is not a theorem: neither is any prefix of it. -/
  spine : Expr → UInt64
    | .app f a => mixHash 13 (mixHash (spine f) (go a))
    | e => go e
  /-- A `fun` whose body is not a proof: nor is that of any `fun` inside it. -/
  lams : Expr → UInt64
    | .lam _ d b bi => mixHash 41 (mixHash (go d) (mixHash (lams b) (hashBI bi)))
    | e => go e

/-- `hashE`, both ways at once, and each subterm a term shares hashed once, by address. -/
private unsafe def hashBothImpl (env : Environment) (orders : NameMap (Array Nat))
    (lp : List Name) (e : Expr) : UInt64 × UInt64 :=
  (go e).run' {} |>.run
where
  /-- A node already hashed: its hash does not depend on where it is, since a node reached by
  `spine` or `lams` hashes as `go` would hash it there. -/
  memo (e : Expr) (k : StateM (Std.HashMap USize (UInt64 × UInt64)) (UInt64 × UInt64)) :
      StateM (Std.HashMap USize (UInt64 × UInt64)) (UInt64 × UInt64) := do
    let a := ptrAddrUnsafe e
    if let some h := (← get).get? a then return h
    let h ← k
    modify (·.insert a h)
    return h
  both (f : UInt64 → UInt64) (h : UInt64 × UInt64) : UInt64 × UInt64 := (f h.1, f h.2)
  go (e : Expr) : StateM (Std.HashMap USize (UInt64 × UInt64)) (UInt64 × UInt64) := do
    match e with
    | .bvar i => let h := mixHash 2 (hash i); return (h, h)
    | .fvar _ => return (3, 3)
    | .mvar _ => return (5, 5)
    | .sort l => return (mixHash 7 (hashLvl lp l.normalize), 7)
    | .const n us =>
      if isTheorem env n then return (proofHash, proofHash)
      return (mixHash 11 (mixHash (hash n) ((canonicalArgs orders n us).foldl (init := 0)
          fun h u => mixHash h (hashLvl lp u.normalize))), mixHash 11 (mixHash (hash n) 0))
    | .app .. => memo e do
        if isErasedProof env e then return (proofHash, proofHash) else spine e
    | .lam .. => memo e do
        if isErasedProof env e then return (proofHash, proofHash) else lams e
    | .forallE _ d b bi => memo e do
        let (d, b) := (← go d, ← go b)
        return (mixHash 43 (mixHash d.1 (mixHash b.1 (hashBI bi))),
          mixHash 43 (mixHash d.2 (mixHash b.2 (hashBI bi))))
    | .letE _ t v b _ => memo e do
        let (t, v, b) := (← go t, ← go v, ← go b)
        return (mixHash 47 (mixHash t.1 (mixHash v.1 b.1)), mixHash 47 (mixHash t.2 (mixHash v.2 b.2)))
    | .lit l => let h := mixHash 53 (hash l); return (h, h)
    | .mdata _ x => go x
    | .proj s i x => memo e do
        return both (fun h => mixHash 59 (mixHash (hash s) (mixHash (hash i) h))) (← go x)
  spine (e : Expr) : StateM (Std.HashMap USize (UInt64 × UInt64)) (UInt64 × UInt64) := do
    match e with
    | .app f a => memo e do
        let (f, a) := (← spine f, ← go a)
        return (mixHash 13 (mixHash f.1 a.1), mixHash 13 (mixHash f.2 a.2))
    | e => go e
  lams (e : Expr) : StateM (Std.HashMap USize (UInt64 × UInt64)) (UInt64 × UInt64) := do
    match e with
    | .lam _ d b bi => memo e do
        let (d, b) := (← go d, ← lams b)
        return (mixHash 41 (mixHash d.1 (mixHash b.1 (hashBI bi))),
          mixHash 41 (mixHash d.2 (mixHash b.2 (hashBI bi))))
    | e => go e

/-- The structural hash of `e`, and the hash with universe levels erased, which `hashE` defines.
Compiled, it is one walk that hashes each shared subterm once: 2.4 times as fast on `Mathlib`'s
types, where the two naive walks took 314 s. -/
@[implemented_by hashBothImpl]
private def hashBoth (env : Environment) (orders : NameMap (Array Nat)) (lp : List Name)
    (e : Expr) : UInt64 × UInt64 :=
  (hashE env orders lp false e, hashE env orders lp true e)

/-! ## Attributes (`a`), from module entries

A state such as the simp set is a fold of per-module entries, and the import stores those
entries whether or not it runs the extensions' import hooks. Plain maps get their own hook run
(`loadExt`); the discrimination trees, which make the full import expensive, are folded into
name sets instead, mirroring each extension's `addEntry`. Only `global` entries count: a
`scoped` one applies inside its namespace only. -/

/-- Run one extension's import hook over its stored entries and install the result, as the full
import does for every extension. Returns how many entries it read. -/
def loadExt {α β σ : Type} [Inhabited σ] (ext : PersistentEnvExtension α β σ)
    (env : Environment) : IO (Environment × Nat) := do
  let s := ext.toEnvExtension.getState (asyncMode := .sync) env
  let state ← ext.addImportedFn s.importedEntries { env, opts := {} }
  return (ext.toEnvExtension.setState (asyncMode := .sync) (log := .unlogged) env { s with state },
    s.importedEntries.foldl (· + ·.size) 0)

/-- The global entries of a scoped extension, in import order. -/
def globalEntries {α β σ : Type} [Inhabited (ScopedEnvExtension.StateStack α β σ)]
    (env : Environment) (ext : ScopedEnvExtension α β σ) : Array α := Id.run do
  let mut out := #[]
  for i in [:env.header.moduleNames.size] do
    for e in ext.ext.getModuleEntries env i do
      if let .global a := e then out := out.push a
  return out

/-- What `SimpTheorems.isLemma (.decl n)` and `toUnfold.contains n` answer, for one simp set. -/
structure SimpNames where
  fwd        : NameSet := {}
  bwd        : NameSet := {}
  toUnfold   : NameSet := {}
  unfoldThms : NameMap (Array Name) := {}
  deriving Inhabited

/-- `SimpTheorems.eraseCore` on the sets above, including its walk over equation lemmas. -/
partial def SimpNames.erase (s : SimpNames) (n : Name) (inv : Bool) : SimpNames :=
  let s := if inv then { s with bwd := s.bwd.erase n } else { s with fwd := s.fwd.erase n }
  let s := { s with toUnfold := s.toUnfold.erase n }
  match s.unfoldThms.find? n with
  | some thms => thms.foldl (fun s t => s.erase t false) s
  | none => s

/-- `SimpTheorems.addSimpEntry` on the sets above. Adding `← n` drops a forward `n`, and the
other way round. -/
def SimpNames.add (s : SimpNames) : Meta.SimpEntry → SimpNames
  | .thm { origin := .decl n _ inv, .. } =>
    let s := if (if inv then s.fwd else s.bwd).contains n then s.erase n !inv else s
    if inv then { s with bwd := s.bwd.insert n } else { s with fwd := s.fwd.insert n }
  | .thm _ => s
  | .toUnfold n => { s with toUnfold := s.toUnfold.insert n }
  | .toUnfoldThms n thms => { s with unfoldThms := s.unfoldThms.insert n thms }

def simpNames (env : Environment) (ext : Meta.SimpExtension) : SimpNames :=
  (globalEntries env ext).foldl SimpNames.add {}

/-- The attribute states the dump reads, as name sets. -/
structure EntryIndex where
  simp     : SimpNames
  simpSets : Array (String × SimpNames)
  /-- `addInstanceEntry` keeps the last entry for a name. -/
  instPrio : NameMap Nat
  ext      : NameSet

def EntryIndex.build (env : Environment) : EntryIndex :=
  let nc := Meta.NormCast.normCastExt
  { simp := simpNames env Meta.simpExtension
    simpSets := #[("norm_cast", simpNames env nc.up), ("norm_cast", simpNames env nc.down),
      ("norm_cast", simpNames env nc.squash),
      ("push_cast", simpNames env Meta.NormCast.pushCastExt)]
    instPrio := (globalEntries env Meta.instanceExtension).foldl (init := {}) fun m e =>
      match e.globalName? with
      | some n => m.insert n e.priority
      | none => m
    ext := (globalEntries env Meta.Ext.extExtension).foldl (·.insert ·.declName) {} }

/-- `n`'s attributes, sorted, from an `EntryIndex` and an environment whose plain-map states
have been loaded (`loadExt`). -/
def entryAttrs (env : Environment) (ix : EntryIndex) (n : Name) : Array String := Id.run do
  let mut out : Array String := #[]
  if ix.simp.fwd.contains n then out := out.push "simp"
  for (tag, s) in ix.simpSets do
    if s.fwd.contains n && !out.contains tag then out := out.push tag
  if ix.simp.toUnfold.contains n then out := out.push "simp-unfold"
  if let some prio := ix.instPrio.find? n then out := out.push s!"instance:{prio}"
  match getReducibilityStatusCore env n with
  | .semireducible => pure ()
  | s => out := out.push s!"reducibility:{s.toAttrString}"
  if ix.ext.contains n then out := out.push "ext"
  -- A tag attribute, read from its module's entries. A generated `rfl` lemma (`@[simps]`) has it
  -- when it holds at the transparency `dsimp` unfolds, so a definition's reducibility decides it.
  if defeqAttr.hasTag env n then out := out.push "defeq"
  return out.qsort (· < ·)

/-! ## Provenance (`x`, `g`), deprecations and aliases -/

/-- A hand-written declaration's `selectionRange` sits strictly inside its `range`, which starts
at the docstring or attributes. A declaration made by an attribute is given the attribute's
syntax for both. False negatives: `@[to_dual (attr := simp)]`. -/
def generatedHeuristic (env : Environment) (n : Name) : Bool :=
  match declRangeExt.find? env n with
  | some r => r.range.pos == r.selectionRange.pos && r.range.endPos == r.selectionRange.endPos
  | none => false

/-- Translation ↦ source, over both translation attributes. `to_dual` records both directions. -/
def translationSources (env : Environment) : NameMap Name := Id.run do
  let mut back : NameMap Name := {}
  for t in [Mathlib.Tactic.ToAdditive.data, Mathlib.Tactic.ToDual.data] do
    for (src, info) in (t.translations.getState env).get do
      unless back.contains info.translation do
        back := back.insert info.translation src
  return back

def optJson : Option String → Json
  | some s => toJson s
  | none => .null

/-- The `@[deprecated]` entry: the replacement, the `since` date and the message. -/
def deprecationJson? (env : Environment) (n : Name) : Option Json :=
  (Linter.deprecatedAttr.getParam? env n).map fun d =>
    Json.mkObj [("to", optJson (d.newName?.map toString)), ("since", optJson d.since?),
      ("text", optJson d.text?)]

/-- What `alias` registered `n` as an alias of, and in which direction for an `Iff`. -/
def aliasJson? (env : Environment) (n : Name) : Option Json :=
  (Batteries.Tactic.Alias.aliasExt.find? env n).map fun
    | .plain t => Json.mkObj [("k", "plain"), ("of", toJson t.toString)]
    | .forward t => Json.mkObj [("k", "forward"), ("of", toJson t.toString)]
    | .reverse t => Json.mkObj [("k", "reverse"), ("of", toJson t.toString)]

/-- Whether `doc` is the docstring `alias` gives an alias written without one. Batteries'
`addAliasDocstring` writes "**Alias** of `X`." (or "…of the forward direction of…", "…of the
reverse direction of…"), followed by `X`'s own docstring after a `---` when `X` has one.
`to_additive` and `to_dual` give their copies of an alias the same. `d` leaves such a
docstring out: nobody wrote it, and it changes whenever the alias is re-pointed. -/
def isAliasDocstring (env : Environment) (n : Name) (doc : String) : Bool :=
  match Batteries.Tactic.Alias.aliasExt.find? env n with
  | some info =>
    let gen := info.toString
    doc.trimAscii.copy == gen || doc.startsWith s!"{gen}\n\n---\n\n"
  | none => false

/-! ## Writing the API dump -/

/-- The fields each extension feeds, which are left out if it reads as empty (*Extensions read
as empty*). -/
def fieldsFedBy : List (String × List String) :=
  [("simp", ["a"]), ("norm_cast", ["a"]), ("push_cast", ["a"]), ("instances", ["a"]),
   ("ext", ["a"]), ("to_additive", ["x"]), ("to_dual", ["x"]), ("matchers", ["rs"]),
   ("declaration ranges", ["g", "l"])]

/-- One declaration's row, as key-value pairs, leaving out empty values. -/
def declRow (env : Environment) (orders : NameMap (Array Nat)) (back : NameMap Name)
    (ix : EntryIndex) (d : ReasonableDecl) (line : Option Nat) : IO (List (String × Json)) := do
  let n := d.name
  let ci := d.info
  -- Universe parameters are numbered canonically, not as declared (*Hashing*).
  let lp := canonicalLevelParams ci
  let str (h : UInt64) := toJson (toString h)
  let ty := hashBoth env orders lp ci.type
  let docHash := ((← findDocString? env n).filter (!isAliasDocstring env n ·)).map
    (hash ·.trimAscii.copy)
  let attrs := entryAttrs env ix n
  let opt (k : String) : Option Json → List (String × Json)
    | some j => [(k, j)]
    | none => []
  let flag (k : String) (b : Bool) : List (String × Json) := if b then [(k, toJson true)] else []
  return [("n", toJson d.str), ("k", toJson (declKind ci)),
      ("m", toJson ((sourceModule? env n).getD .anonymous).toString),
      ("t", str ty.1), ("te", toJson (toString ty.2.toUInt32))]
    ++ opt "v" (if ci.isTheorem then none else ci.value?.map fun v => str (hashBoth env orders lp v).1)
    ++ opt "d" (docHash.map str)
    ++ (if attrs.isEmpty then [] else [("a", toJson attrs)])
    ++ flag "p" (isProtected env n)
    ++ opt "x" ((back.find? n).map (toJson ·.toString))
    ++ flag "g" (generatedHeuristic env n)
    ++ opt "dep" (deprecationJson? env n)
    ++ opt "al" (aliasJson? env n)
    ++ flag "rs" (isReservedName env n)
    ++ (if ci.levelParams.isEmpty then [] else [("nu", toJson ci.levelParams.length)])
    ++ (if lp == ci.levelParams then [] else [("uo", Json.mkObj [
        ("d", toJson (ci.levelParams.map toString)), ("p", toJson (ci.levelParams.map lp.idxOf))])])
    ++ opt "l" (line.map toJson)

/-- The hash of a module's source file, found through `LEAN_SRC_PATH`, or `none`. -/
def sourceHash? (sp : SearchPath) (mod : Name) : IO (Option UInt64) := do
  let some p ← sp.findModuleWithExt "lean" mod | return none
  return some (hash (← IO.FS.readBinFile p))

/-- One module's row, as key-value pairs, leaving out empty values. Deleting a deprecated
module leaves no declaration behind, so modules need rows of their own. -/
def moduleRow (env : Environment) (sp : SearchPath) (mod : Name) : IO (List (String × Json)) := do
  let some idx := env.getModuleIdx? mod | return [("mod", toJson mod.toString)]
  let dm? := env.getDeprecatedModuleByIdx? idx
  let docs := (getModuleDoc? env mod).getD #[]
  let imps := match dm?, env.header.moduleData[idx.toNat]? with
    | some _, some d => d.imports.map (toJson ·.module.toString)
    | _, _ => #[]
  let src ← sourceHash? sp mod
  return [("mod", toJson mod.toString)]
    ++ (dm?.map fun e => ("dm", Json.mkObj [("since", optJson e.since?),
          ("text", optJson e.message?)])).toList
    ++ (if docs.isEmpty then []
        else [("md", toJson (toString (hash (docs.map (·.doc.trimAscii.copy)).toList)))])
    ++ (if imps.isEmpty then [] else [("imp", Json.arr imps)])
    ++ (src.map fun h => ("src", toJson (toString h))).toList

/-- Write the API dump: the header, a row per declaration, then a row per module under the
roots. Returns the number of declaration rows and of module rows. -/
private def writeApiDump (env : Environment) (roots : Array Name)
    (decls : Array ReasonableDecl) (outFile : System.FilePath) : IO (Nat × Nat) := do
  -- The plain maps: matchers (`rs`), reducibility set outside a declaration's module, and the
  -- translation maps (`x`).
  let (env, matchers) ← loadExt Meta.Match.Extension.extension env
  let (env, _) ← loadExt reducibilityExtraExt.ext env
  let translations (t : Mathlib.Tactic.Translate.TranslateData) :
      PersistentEnvExtension _ _ (List _ × Thunk (NameMap _)) := t.translations
  let (env, additive) ← loadExt (translations Mathlib.Tactic.ToAdditive.data) env
  let (env, dual) ← loadExt (translations Mathlib.Tactic.ToDual.data) env
  let ix := EntryIndex.build env
  let back := translationSources env
  let orders := canonicalArgOrders env
  let walk : CoreM (Array (List (String × Json)) × Nat) := do
    let mut rows := #[]
    let mut ranged := 0
    for d in decls do
      -- The name's line, not the docstring's, so that a link lands on `theorem foo`.
      -- `findDeclarationRanges?` gives a recursor its inductive's range.
      let line := (← findDeclarationRanges? d.name).map (·.selectionRange.pos.line)
      if line.isSome then ranged := ranged + 1
      rows := rows.push (← declRow env orders back ix d line)
    return (rows, ranged)
  let ((rows, ranged), _) ← walk.toIO { fileName := "<dumpReasonableDecls>", fileMap := default }
    { env }
  let counts := [("simp", ix.simp.fwd.size + ix.simp.bwd.size),
    ("norm_cast", (ix.simpSets.filter (·.1 == "norm_cast")).foldl (· + ·.2.fwd.size) 0),
    ("push_cast", (ix.simpSets.filter (·.1 == "push_cast")).foldl (· + ·.2.fwd.size) 0),
    ("instances", ix.instPrio.size), ("ext", ix.ext.size), ("to_additive", additive),
    ("to_dual", dual), ("matchers", matchers), ("declaration ranges", ranged)]
  let mut dropped : List String := []
  for (what, n) in counts do
    if n == 0 then
      let fs := (List.lookup what fieldsFedBy).getD []
      IO.eprintln s!"warning: {what} read as empty; leaving out {", ".intercalate fs}"
      dropped := dropped ++ fs
  let fields := apiFields.filter (!dropped.contains ·.1)
  let header := Json.mkObj [("schema", toJson apiSchema),
    ("fields", Json.mkObj (fields.map fun (k, v) => (k, toJson v)))]
  let mods := env.allImportedModuleNames.filter (underAnyRoot roots) |>.qsort (·.toString < ·.toString)
  let sp ← getSrcSearchPath
  let keep (kvs : List (String × Json)) := kvs.filter (!dropped.contains ·.1)
  IO.FS.withFile outFile .write fun h => do
    h.putStrLn header.compress
    for r in rows do
      h.putStrLn (Json.mkObj (keep r)).compress
    for m in mods do
      h.putStrLn (Json.mkObj (keep (← moduleRow env sp m))).compress
  return (decls.size, mods.size)

/-- Write the transitive-import counts JSON. Keys are strict descendants of
any configured root; non-root boundary leaves are dropped from the key set.
Output format matches `count-trans-deps.py`. -/
private def writeImportsDump (env : Environment) (roots : Array Name)
    (outFile : System.FilePath) : IO Nat := do
  let fullGraph := env.importGraph
  -- Drop edges whose source is NOT under any configured root. Non-root
  -- targets survive only as leaves — they have no outgoing edges in the
  -- restricted graph, so they get counted once as a direct import of any
  -- root module that mentions them, but the search does not descend.
  let restricted : NameMap (Array Name) :=
    fullGraph.foldl (init := ({} : NameMap (Array Name))) fun acc src deps =>
      if roots.any (·.isPrefixOf src) then acc.insert src deps
      else acc
  let closure := restricted.transitiveClosure
  -- Restrict to strict descendants of a root (drops the root itself and
  -- any non-root keys that snuck in). Sort by key for deterministic bytes.
  let pairs : Array (String × Json) :=
    closure.foldl (init := #[]) fun acc n s =>
      if roots.any (fun p => p != n && p.isPrefixOf n) then
        acc.push (n.toString, Json.num s.size)
      else acc
  let sorted := pairs.qsort (fun a b => a.1 < b.1)
  let json := Json.mkObj sorted.toList
  IO.FS.writeFile outFile json.compress
  return sorted.size

unsafe def runDump (cfg : Config) : IO UInt32 := do
  Lean.initSearchPath (← Lean.findSysroot)
  Lean.enableInitializersExecution
  let imports : Array Import := cfg.roots.map ({ module := · })
  Lean.withImportModules imports {} (trustLevel := 1024) fun env => do
    let rootsStr := " ".intercalate (cfg.roots.toList.map toString)
    let decls :=
      if cfg.declsOut.isSome || cfg.apiOut.isSome then reasonableDecls env cfg.roots else #[]
    if let some path := cfg.declsOut then
      writeDeclsDump decls path
      IO.println s!"Wrote {decls.size} reasonable declarations from [{rootsStr}] to {path}"
    if let some path := cfg.apiOut then
      let (nd, nm) ← writeApiDump env cfg.roots decls path
      IO.println s!"Wrote the API of {nd} declarations and {nm} modules from [{rootsStr}] to {path}"
    if let some path := cfg.importsOut then
      let n ← writeImportsDump env cfg.roots path
      IO.println s!"Wrote {n} transitive-import counts from [{rootsStr}] to {path}"
    return 0

def main (args : List String) : IO UInt32 := do
  let mut cfg := (← parseArgs args {}).withOutDir
  if let some d := cfg.outDir then IO.FS.createDirAll d
  if cfg.declsOut.isNone && cfg.importsOut.isNone && cfg.apiOut.isNone then
    cfg := { cfg with declsOut := some "reasonable_decls.txt" }
  unsafe runDump cfg
